generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ScanRecord {
  id           String   @id @default(cuid())
  scanHash     String
  userId       String?
  projectName  String
  appType      String
  stage        String
  score        Int
  findingCount Int
  scannedAt    DateTime
  payload      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@unique([userId, scanHash])
  @@index([stage, createdAt])
  @@index([appType, createdAt])
  @@index([score, createdAt])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  scans         ScanRecord[]
  guidanceFeedback GuidanceFeedback[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BetaInvite {
  email     String   @id
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model ScanRateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

model GuidanceFeedback {
  id             String   @id @default(cuid())
  userId         String
  guidanceId     String
  catalogVersion String
  helpful        Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, guidanceId, catalogVersion])
  @@index([userId, updatedAt])
}
