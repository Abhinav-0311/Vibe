# App
NEXT_PUBLIC_APP_URL=http://localhost:3005
# Local filesystem scanning is for trusted local/self-hosted use. Keep false/unset on Vercel.
VIBE_ENABLE_LOCAL_SCAN=

# AI report generation
# Add a real key only in your local .env file or deployment secret store.
OPENAI_API_KEY=
# AI enhancement is opt-in so local scans do not create unexpected API usage.
OPENAI_REPORT_ENABLED=false
OPENAI_REPORT_MODEL=gpt-5.4-mini
# Optional: set current model prices yourself to record an estimate per enhanced report.
OPENAI_REPORT_INPUT_COST_PER_MILLION_USD=
OPENAI_REPORT_OUTPUT_COST_PER_MILLION_USD=

# Database persistence
# Docker Compose example: postgresql://postgres:postgres@localhost:5433/vibe?schema=public
# Native PostgreSQL example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/vibe?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Required on shared deployments to keep public scan limits private and consistent across server instances.
VIBE_RATE_LIMIT_SECRET=
# Saved scan payloads are automatically removed after this many days. Keep the MVP default of 30 unless a shorter policy is required.
VIBE_SCAN_RETENTION_DAYS=30
# Private-beta accounts. Google values and NEXTAUTH_SECRET are deployment secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3005
NEXTAUTH_SECRET=
# Maximum saved scans per invited user in any rolling 24-hour period.
VIBE_BETA_DAILY_SCAN_LIMIT=20

# GitHub OAuth
# Callback URL: http://localhost:3005/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Use a random value containing at least 32 characters.
GITHUB_TOKEN_ENCRYPTION_KEY=

# Future observability layer
SENTRY_DSN=
